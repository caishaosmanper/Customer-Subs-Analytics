      <aliases enabled='yes' />
      <column caption='Sales Mix' datatype='real' default-format='p0%' name='[Calculation_1122100010721341441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sales]) / TOTAL(SUM([sales])) * 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Date Ranfe' datatype='date' datatype-customized='true' name='[Calculation_1122100010722054146]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(IF NOT ISNULL( DATEPARSE ( &quot;yy&quot;, STR(DATEDIFF(&apos;day&apos;, [signup_date], [cancel_date])) )  ) THEN DATEPARSE ( &quot;yy&quot;, STR(DATEDIFF(&apos;day&apos;, [signup_date], [cancel_date])) )   ELSEIF NOT ISNULL ( DATEPARSE ( &quot;MMyy&quot;, STR(DATEDIFF(&apos;day&apos;, [signup_date], [cancel_date])) )  ) THEN DATEPARSE ( &quot;MMyy&quot;, STR(DATEDIFF(&apos;day&apos;, [signup_date], [cancel_date])) )   END)' />
      </column>
      <column caption='Max Sales' datatype='integer' datatype-customized='true' name='[Calculation_1122100010726760452]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF SUM([sales]) == WINDOW_MAX(SUM([sales])) THEN SUM([sales]) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Max Cancelations' datatype='integer' datatype-customized='true' name='[Max Sales (copy)_257901468116959232]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF COUNT([cancel_date]) == WINDOW_MAX(COUNT([cancel_date])) THEN COUNT([cancel_date]) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Date' datatype='date' name='[Signup Date (copy)_6505027469219930113]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='[signup_date]' />
      </column>
